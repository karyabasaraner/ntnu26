{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/${fileBasenameNoExtension}",
            "preLaunchTask": "Build current test",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug core-log",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/core-log",
            "args": [
                "configs/four-cameras.yaml",
                "/mnt/storage/log.mcap"
            ],
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
